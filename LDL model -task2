import numpy as np
from scipy.special import factorial

def get_stehfest_v(i, N):
    """計算 Stehfest 權重係數 Vi"""
    n2 = N // 2
    v = 0
    # 這是 Stehfest 的標準加權公式
    for k in range((i + 1) // 2, min(i, n2) + 1):
        num = (k**n2) * factorial(2 * k)
        den = factorial(n2 - k) * factorial(k) * factorial(k - 1) * \
              factorial(i - k) * factorial(2 * k - i)
        v += num / den
    
    # 加上正負號項 (-1)^(N/2 + i)
    return ((-1)**(n2 + i)) * v

def stehfest_inversion(func, t, params, N=12):
    ln2 = np.log(2.0)
    s = 0.0
    for i in range(1, N + 1):
        # --- 修正處：呼叫我們剛剛定義好的權重計算 ---
        v = get_stehfest_v(i, N) 
        # ----------------------------------------
        p = i * ln2 / t
        s += v * func(p, params)
    return (ln2 / t) * s

# 設定一系列的時間點 
times = np.logspace(-5, 2, 100)
drawdowns = [] # 準備一個空籃子裝水位數據

true_params = {'T': 10, 'S': 0.0001, 'tau_q': 0.2, 'tau_s': 2}
def get_model_drawdown(params_values, times, base_params):
    # 將陣列形式的參數對應回字典
    T, S, tau_q, tau_s = params_values
    p_temp = base_params.copy()
    p_temp.update({'T': T, 'S': S, 'tau_q': tau_q, 'tau_s': tau_s})
    
    drawdowns = []
    for t in times:
        tD = T * t / (S * p_temp['rw']**2)
        sD = stehfest_inversion(laplace_domain_solution, tD, p_temp)
        s = sD * (p_temp['Q'] / (4 * np.pi * T))
        
        # 保留您的偵錯機制
        if np.isnan(s) or np.isinf(s):
            s = 0  # 在最佳化過程中，建議將錯誤值設為 0 或極大值，避免程式中斷
        
        drawdowns.append(s)
    return np.array(drawdowns)

y_true = get_model_drawdown([true_params['T'], true_params['S'], true_params['tau_q'], true_params['tau_s']], times, params)
noise = np.random.normal(0, 0.05 * np.max(y_true), size=len(y_true)) # 2% 標準差的雜訊
y_obs = y_true + noise

def objective(guess):
    y_pred = get_model_drawdown(guess, times, params)
    return np.sqrt(np.mean((y_obs - y_pred)**2))
initial_guess = [8, 0.0002, 0.1, 1] 
bounds = [(5, 15), (1e-6, 1e-2), (0.01, 0.5), (0.1, 5)]
res = minimize(objective, initial_guess, bounds=bounds, method='L-BFGS-B')
fitted_params = res.x
y_fitted = get_model_drawdown(fitted_params, times, params)

